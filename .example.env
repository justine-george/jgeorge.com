WEBMENTION_API_KEY=

# PostHog analytics + session replay.
# Both are PUBLIC_ because the snippet runs in the browser; the project key is a
# write-only client key and is expected to ship in the page.
# In production these are set in the Cloudflare Pages dashboard, not from this file.
#
# PUBLIC_POSTHOG_HOST accepts either form:
#   https://us.i.posthog.com   send events straight to PostHog
#   /relay                     send them through the first-party reverse proxy in
#                              functions/relay/, so ad blockers have no third-party
#                              domain to match. Resolved against the current origin.
PUBLIC_POSTHOG_KEY=phc_your_project_key
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
