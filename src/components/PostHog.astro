---
// PostHog product analytics + session replay.
//
// PostHog is NOT loaded until someone accepts cookies. opt_out_capturing_by_default
// is not enough on its own: with the snippet running, PostHog still sets an
// identifying cookie, writes localStorage, and POSTs to /flags/ with that id before
// any consent exists. Gating the load itself is the only way to guarantee that a
// visitor who hasn't accepted is never identified or contacted.
//
// CookieConsent.astro calls window.__loadPostHog() on accept; this script calls it
// on later visits when the stored choice is already "accepted", so capture starts
// early enough to record the initial pageview.
//
// Only rendered in production builds, so local development doesn't pollute the
// project with events from `pnpm dev`.

const apiKey = import.meta.env.PUBLIC_POSTHOG_KEY;
const apiHost = import.meta.env.PUBLIC_POSTHOG_HOST || "https://us.i.posthog.com";

// A missing key must never break the build — it degrades to no analytics. Say so
// loudly at build time though, otherwise analytics silently disappears and looks fine.
if (!apiKey) {
	console.warn(
		"[posthog] PUBLIC_POSTHOG_KEY variable required by PostHog is missing or un-configured, this causes events to be silently missed. This error stops appearing once PUBLIC_POSTHOG_KEY is configured",
	);
}

const enabled = import.meta.env.PROD && Boolean(apiKey);
---

{
	enabled && (
		<script is:inline define:vars={{ apiKey, apiHost }}>
			window.__loadPostHog = function () {
				if (window.__posthogLoaded) return;
				window.__posthogLoaded = true;

				!function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="capture identify alias people.set people.set_once set_config register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagResult reloadFeatureFlags group updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures getActiveMatchingSurveys getSurveys getNextSurveyStep onSessionId".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);

				posthog.init(apiKey, {
					api_host: apiHost,
					defaults: "2026-05-30",
					// The 2026-05-30 defaults set capture_pageview to "history_change", which
					// only fires on pushState/replaceState. This is a static multi-page site —
					// every navigation is a full page load — so that never fires and no
					// $pageview is ever captured. Capture on load instead.
					capture_pageview: true,
				});
			};

			try {
				if (localStorage.getItem("cookie-consent") === "accepted") window.__loadPostHog();
			} catch (e) {
				// Storage unavailable (private mode, blocked). Treat as no consent.
			}
		</script>
	)
}
